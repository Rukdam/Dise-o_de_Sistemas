@page "/"
@using FrontendBlazor.Models
@using FrontendBlazor.Services
@inject ProyectoService ProyectoService
@inject UsuarioService UsuarioService
@inject TareaService TareaService
@rendermode InteractiveServer

<PageTitle>Sistema de Gestión de Proyectos</PageTitle>

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4">
                <i class="bi bi-clipboard-check"></i> Sistema de Gestión de Proyectos
            </h1>
            <p class="lead">Bienvenido al sistema de gestión de proyectos, tareas y usuarios</p>
        </div>
    </div>

    @if (cargando)
    {
        <div class="text-center">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card text-white bg-primary h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title">Proyectos</h5>
                                <h2 class="display-4">@totalProyectos</h2>
                            </div>
                            <i class="bi bi-folder-fill" style="font-size: 3rem;"></i>
                        </div>
                        <p class="card-text mt-2">Total de proyectos registrados</p>
                        <a href="/proyectos" class="btn btn-light">Ver Proyectos</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-white bg-success h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title">Usuarios</h5>
                                <h2 class="display-4">@totalUsuarios</h2>
                            </div>
                            <i class="bi bi-people-fill" style="font-size: 3rem;"></i>
                        </div>
                        <p class="card-text mt-2">Usuarios activos en el sistema</p>
                        <a href="/usuarios" class="btn btn-light">Ver Usuarios</a>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card text-white bg-info h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="card-title">Tareas</h5>
                                <h2 class="display-4">@totalTareas</h2>
                            </div>
                            <i class="bi bi-list-check" style="font-size: 3rem;"></i>
                        </div>
                        <p class="card-text mt-2">Tareas totales registradas</p>
                        <a href="/tareas" class="btn btn-light">Ver Tareas</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-graph-up"></i> Estado de Proyectos</h5>
                    </div>
                    <div class="card-body">
                        @if (proyectos.Any())
                        {
                            <div class="list-group">
                                @foreach (var grupo in proyectos.GroupBy(p => p.Estado))
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@grupo.Key</span>
                                        <span class="badge bg-primary rounded-pill">@grupo.Count()</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No hay proyectos registrados</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card">
                    <div class="card-header bg-info text-white">
                        <h5 class="mb-0"><i class="bi bi-pie-chart"></i> Estado de Tareas</h5>
                    </div>
                    <div class="card-body">
                        @if (tareas.Any())
                        {
                            <div class="list-group">
                                @foreach (var grupo in tareas.GroupBy(t => t.Estado))
                                {
                                    <div class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>@grupo.Key</span>
                                        <span class="badge bg-info rounded-pill">@grupo.Count()</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted">No hay tareas registradas</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header bg-dark text-white">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> Información del Sistema</h5>
                    </div>
                    <div class="card-body">
                        <p>Este sistema permite gestionar proyectos, usuarios y tareas de manera integrada.</p>
                        <ul>
                            <li><strong>Proyectos:</strong> Crea y administra proyectos con fechas, presupuestos y estados.</li>
                            <li><strong>Usuarios:</strong> Gestiona los usuarios del sistema con diferentes roles.</li>
                            <li><strong>Tareas:</strong> Asigna tareas a proyectos y usuarios con prioridades y fechas de vencimiento.</li>
                        </ul>
                        <p class="mb-0">Utiliza el menú de navegación para acceder a cada módulo.</p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Proyecto> proyectos = new();
    private List<Usuario> usuarios = new();
    private List<Tarea> tareas = new();
    private bool cargando = true;

    private int totalProyectos => proyectos.Count;
    private int totalUsuarios => usuarios.Count;
    private int totalTareas => tareas.Count;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        proyectos = await ProyectoService.GetProyectosAsync();
        usuarios = await UsuarioService.GetUsuariosAsync();
        tareas = await TareaService.GetTareasAsync();
        cargando = false;
    }
}
