@page "/tareas"
@using FrontendBlazor.Models
@using FrontendBlazor.Services
@inject TareaService TareaService
@inject ProyectoService ProyectoService
@inject UsuarioService UsuarioService
@rendermode InteractiveServer

<PageTitle>Tareas</PageTitle>

<h1>Gestión de Tareas</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="MostrarFormularioNuevo">
        <i class="bi bi-plus-circle"></i> Nueva Tarea
    </button>
</div>

@if (mostrarFormulario)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5>@(tareaEditando?.Id > 0 ? "Editar Tarea" : "Nueva Tarea")</h5>
        </div>
        <div class="card-body">
            <EditForm Model="@tareaEditando" OnValidSubmit="@GuardarTarea">
                <div class="mb-3">
                    <label class="form-label">Título:</label>
                    <InputText class="form-control" @bind-Value="tareaEditando.Titulo" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción:</label>
                    <InputTextArea class="form-control" @bind-Value="tareaEditando.Descripcion" rows="3" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Proyecto:</label>
                        <InputSelect class="form-control" @bind-Value="tareaEditando.ProyectoId">
                            <option value="0">Seleccione un proyecto</option>
                            @foreach (var proyecto in proyectos)
                            {
                                <option value="@proyecto.Id">@proyecto.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Usuario Asignado:</label>
                        <InputSelect class="form-control" @bind-Value="tareaEditando.UsuarioAsignadoId">
                            <option value="">Sin asignar</option>
                            @foreach (var usuario in usuarios)
                            {
                                <option value="@usuario.Id">@usuario.Nombre</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Estado:</label>
                        <InputSelect class="form-control" @bind-Value="tareaEditando.Estado">
                            <option value="Pendiente">Pendiente</option>
                            <option value="En Progreso">En Progreso</option>
                            <option value="Completada">Completada</option>
                            <option value="Cancelada">Cancelada</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Prioridad:</label>
                        <InputSelect class="form-control" @bind-Value="tareaEditando.Prioridad">
                            <option value="Baja">Baja</option>
                            <option value="Media">Media</option>
                            <option value="Alta">Alta</option>
                            <option value="Crítica">Crítica</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Fecha Vencimiento:</label>
                        <InputDate class="form-control" @bind-Value="tareaEditando.FechaVencimiento" />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEdicion">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (cargando)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (tareas.Count == 0)
{
    <div class="alert alert-info">
        No hay tareas registradas. Crea una nueva para comenzar.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Proyecto</th>
                    <th>Usuario</th>
                    <th>Estado</th>
                    <th>Prioridad</th>
                    <th>Vencimiento</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tarea in tareas)
                {
                    <tr>
                        <td>@tarea.Id</td>
                        <td>@tarea.Titulo</td>
                        <td>@(tarea.Descripcion.Length > 50 ? tarea.Descripcion.Substring(0, 50) + "..." : tarea.Descripcion)</td>
                        <td>@ObtenerNombreProyecto(tarea.ProyectoId)</td>
                        <td>@ObtenerNombreUsuario(tarea.UsuarioAsignadoId)</td>
                        <td>
                            <span class="badge bg-@ObtenerColorEstado(tarea.Estado)">
                                @tarea.Estado
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-@ObtenerColorPrioridad(tarea.Prioridad)">
                                @tarea.Prioridad
                            </span>
                        </td>
                        <td>@(tarea.FechaVencimiento?.ToShortDateString() ?? "N/A")</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => EditarTarea(tarea)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarTarea(tarea.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-@tipoMensaje alert-dismissible fade show mt-3" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
    </div>
}

@code {
    private List<Tarea> tareas = new();
    private List<Proyecto> proyectos = new();
    private List<Usuario> usuarios = new();
    private Tarea tareaEditando = new();
    private bool mostrarFormulario = false;
    private bool cargando = true;
    private string mensaje = string.Empty;
    private string tipoMensaje = "info";

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        cargando = true;
        tareas = await TareaService.GetTareasAsync();
        proyectos = await ProyectoService.GetProyectosAsync();
        usuarios = await UsuarioService.GetUsuariosAsync();
        cargando = false;
    }

    private void MostrarFormularioNuevo()
    {
        tareaEditando = new Tarea
        {
            FechaCreacion = DateTime.Now,
            Estado = "Pendiente",
            Prioridad = "Media"
        };
        mostrarFormulario = true;
    }

    private void EditarTarea(Tarea tarea)
    {
        tareaEditando = new Tarea
        {
            Id = tarea.Id,
            Titulo = tarea.Titulo,
            Descripcion = tarea.Descripcion,
            ProyectoId = tarea.ProyectoId,
            UsuarioAsignadoId = tarea.UsuarioAsignadoId,
            Estado = tarea.Estado,
            Prioridad = tarea.Prioridad,
            FechaCreacion = tarea.FechaCreacion,
            FechaVencimiento = tarea.FechaVencimiento
        };
        mostrarFormulario = true;
    }

    private async Task GuardarTarea()
    {
        bool exito;
        
        if (tareaEditando.Id > 0)
        {
            exito = await TareaService.UpdateTareaAsync(tareaEditando.Id, tareaEditando);
            mensaje = exito ? "Tarea actualizada exitosamente" : "Error al actualizar la tarea";
        }
        else
        {
            exito = await TareaService.CreateTareaAsync(tareaEditando);
            mensaje = exito ? "Tarea creada exitosamente" : "Error al crear la tarea";
        }

        tipoMensaje = exito ? "success" : "danger";
        
        if (exito)
        {
            mostrarFormulario = false;
            await CargarDatos();
        }
    }

    private void CancelarEdicion()
    {
        mostrarFormulario = false;
        tareaEditando = new();
    }

    private async Task EliminarTarea(int id)
    {
        if (await TareaService.DeleteTareaAsync(id))
        {
            mensaje = "Tarea eliminada exitosamente";
            tipoMensaje = "success";
            await CargarDatos();
        }
        else
        {
            mensaje = "Error al eliminar la tarea";
            tipoMensaje = "danger";
        }
    }

    private string ObtenerNombreProyecto(int proyectoId)
    {
        var proyecto = proyectos.FirstOrDefault(p => p.Id == proyectoId);
        return proyecto?.Nombre ?? "N/A";
    }

    private string ObtenerNombreUsuario(int? usuarioId)
    {
        if (!usuarioId.HasValue) return "Sin asignar";
        var usuario = usuarios.FirstOrDefault(u => u.Id == usuarioId.Value);
        return usuario?.Nombre ?? "N/A";
    }

    private string ObtenerColorEstado(string estado)
    {
        return estado switch
        {
            "Pendiente" => "warning",
            "En Progreso" => "info",
            "Completada" => "success",
            "Cancelada" => "danger",
            _ => "secondary"
        };
    }

    private string ObtenerColorPrioridad(string prioridad)
    {
        return prioridad switch
        {
            "Baja" => "secondary",
            "Media" => "primary",
            "Alta" => "warning",
            "Crítica" => "danger",
            _ => "secondary"
        };
    }
}
