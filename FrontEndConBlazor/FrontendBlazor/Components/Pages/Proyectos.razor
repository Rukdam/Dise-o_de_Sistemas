@page "/proyectos"
@using FrontendBlazor.Models
@using FrontendBlazor.Services
@inject ProyectoService ProyectoService
@rendermode InteractiveServer

<PageTitle>Proyectos</PageTitle>

<h1>Gestión de Proyectos</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="MostrarFormularioNuevo">
        <i class="bi bi-plus-circle"></i> Nuevo Proyecto
    </button>
</div>

@if (mostrarFormulario)
{
    <div class="card mb-4">
        <div class="card-header">
            <h5>@(proyectoEditando?.Id > 0 ? "Editar Proyecto" : "Nuevo Proyecto")</h5>
        </div>
        <div class="card-body">
            <EditForm Model="@proyectoEditando" OnValidSubmit="@GuardarProyecto">
                <div class="mb-3">
                    <label class="form-label">Nombre:</label>
                    <InputText class="form-control" @bind-Value="proyectoEditando.Nombre" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Descripción:</label>
                    <InputTextArea class="form-control" @bind-Value="proyectoEditando.Descripcion" rows="3" />
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha Inicio:</label>
                        <InputDate class="form-control" @bind-Value="proyectoEditando.FechaInicio" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Fecha Fin:</label>
                        <InputDate class="form-control" @bind-Value="proyectoEditando.FechaFin" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Estado:</label>
                        <InputSelect class="form-control" @bind-Value="proyectoEditando.Estado">
                            <option value="Activo">Activo</option>
                            <option value="En Progreso">En Progreso</option>
                            <option value="Completado">Completado</option>
                            <option value="Cancelado">Cancelado</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Presupuesto:</label>
                        <InputNumber class="form-control" @bind-Value="proyectoEditando.Presupuesto" />
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-save"></i> Guardar
                    </button>
                    <button type="button" class="btn btn-secondary" @onclick="CancelarEdicion">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (cargando)
{
    <div class="text-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}
else if (proyectos.Count == 0)
{
    <div class="alert alert-info">
        No hay proyectos registrados. Crea uno nuevo para comenzar.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Descripción</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Estado</th>
                    <th>Presupuesto</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proyecto in proyectos)
                {
                    <tr>
                        <td>@proyecto.Id</td>
                        <td>@proyecto.Nombre</td>
                        <td>@proyecto.Descripcion</td>
                        <td>@proyecto.FechaInicio.ToShortDateString()</td>
                        <td>@(proyecto.FechaFin?.ToShortDateString() ?? "N/A")</td>
                        <td>
                            <span class="badge bg-@ObtenerColorEstado(proyecto.Estado)">
                                @proyecto.Estado
                            </span>
                        </td>
                        <td>@proyecto.Presupuesto.ToString("C")</td>
                        <td>
                            <button class="btn btn-sm btn-warning me-1" @onclick="() => EditarProyecto(proyecto)">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" @onclick="() => EliminarProyecto(proyecto.Id)">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert alert-@tipoMensaje alert-dismissible fade show mt-3" role="alert">
        @mensaje
        <button type="button" class="btn-close" @onclick="() => mensaje = string.Empty"></button>
    </div>
}

@code {
    private List<Proyecto> proyectos = new();
    private Proyecto proyectoEditando = new();
    private bool mostrarFormulario = false;
    private bool cargando = true;
    private string mensaje = string.Empty;
    private string tipoMensaje = "info";

    protected override async Task OnInitializedAsync()
    {
        await CargarProyectos();
    }

    private async Task CargarProyectos()
    {
        cargando = true;
        proyectos = await ProyectoService.GetProyectosAsync();
        cargando = false;
    }

    private void MostrarFormularioNuevo()
    {
        proyectoEditando = new Proyecto
        {
            FechaInicio = DateTime.Now,
            Estado = "Activo"
        };
        mostrarFormulario = true;
    }

    private void EditarProyecto(Proyecto proyecto)
    {
        proyectoEditando = new Proyecto
        {
            Id = proyecto.Id,
            Nombre = proyecto.Nombre,
            Descripcion = proyecto.Descripcion,
            FechaInicio = proyecto.FechaInicio,
            FechaFin = proyecto.FechaFin,
            Estado = proyecto.Estado,
            Presupuesto = proyecto.Presupuesto
        };
        mostrarFormulario = true;
    }

    private async Task GuardarProyecto()
    {
        bool exito;
        
        if (proyectoEditando.Id > 0)
        {
            exito = await ProyectoService.UpdateProyectoAsync(proyectoEditando.Id, proyectoEditando);
            mensaje = exito ? "Proyecto actualizado exitosamente" : "Error al actualizar el proyecto";
        }
        else
        {
            exito = await ProyectoService.CreateProyectoAsync(proyectoEditando);
            mensaje = exito ? "Proyecto creado exitosamente" : "Error al crear el proyecto";
        }

        tipoMensaje = exito ? "success" : "danger";
        
        if (exito)
        {
            mostrarFormulario = false;
            await CargarProyectos();
        }
    }

    private void CancelarEdicion()
    {
        mostrarFormulario = false;
        proyectoEditando = new();
    }

    private async Task EliminarProyecto(int id)
    {
        if (await ProyectoService.DeleteProyectoAsync(id))
        {
            mensaje = "Proyecto eliminado exitosamente";
            tipoMensaje = "success";
            await CargarProyectos();
        }
        else
        {
            mensaje = "Error al eliminar el proyecto";
            tipoMensaje = "danger";
        }
    }

    private string ObtenerColorEstado(string estado)
    {
        return estado switch
        {
            "Activo" => "primary",
            "En Progreso" => "info",
            "Completado" => "success",
            "Cancelado" => "danger",
            _ => "secondary"
        };
    }
}
